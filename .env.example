# Local Supabase URL for iOS simulator / local development.
# For a physical device, replace 127.0.0.1 with your computer's LAN IP.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Copy the local publishable/anon key shown by: npm run supabase:status
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me
